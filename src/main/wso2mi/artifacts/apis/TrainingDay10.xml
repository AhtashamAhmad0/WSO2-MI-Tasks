<?xml version="1.0" encoding="UTF-8"?>
<api xmlns="http://ws.apache.org/ns/synapse" name="TrainingDay10" context="/customer">
    
    <!-- 1. POST /customer - Create Customer -->
    <resource methods="POST" uri-template="">
        <inSequence>
            <sequence key="CustomerCreateSequence"/>
        </inSequence>
        <outSequence/>
        <faultSequence>
            <sequence key="CustomerFaultSequence"/>
        </faultSequence>
    </resource>

    <!-- 2. GET /customer/{id} - Retrieve Customer -->
    <resource methods="GET" uri-template="/{id}">
        <inSequence>
            <sequence key="CustomerGetSequence"/>
        </inSequence>
        <outSequence/>
        <faultSequence>
            <sequence key="CustomerFaultSequence"/>
        </faultSequence>
    </resource>

    <!-- 3. PUT /customer/{id} - Update Customer -->
    <resource methods="PUT" uri-template="/{id}">
        <inSequence>
            <sequence key="CustomerUpdateSequence"/>
        </inSequence>
        <outSequence/>
        <faultSequence>
            <sequence key="CustomerFaultSequence"/>
        </faultSequence>
    </resource>

    <!-- 4. DELETE /customer/{id} - Delete Customer -->
    <resource methods="DELETE" uri-template="/{id}">
        <inSequence>
            <sequence key="CustomerDeleteSequence"/>
        </inSequence>
        <outSequence/>
        <faultSequence>
            <sequence key="CustomerFaultSequence"/>
        </faultSequence>
    </resource>



