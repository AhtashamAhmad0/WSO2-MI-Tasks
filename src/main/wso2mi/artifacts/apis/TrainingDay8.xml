        <inSequence>
            <sequence key="Day8Practice4PostSequence"/>
        </inSequence>
        <faultSequence>
            <sequence key="Day8FaultSequence"/>
        </faultSequence>
    </resource>


     <!-- Practice 5: End-to-end tracing -->
    <resource methods="GET" uri-template="/p5/transaction/{id}">
        <inSequence>
            <sequence key="Day8Practice5Sequence"/>
        </inSequence>
        <faultSequence>
            <sequence key="Day8FaultSequence"/>
        </faultSequence>
    </resource>


    
</api>