    <resource methods="GET" uri-template="/p1/customer/{id}">
        <inSequence>
            <sequence key="Day8Practice1Sequence"/>
        </inSequence>
        <outSequence/>
        <faultSequence/>
    </resource>


    <resource methods="POST" uri-template="/add" >
    <inSequence>
        <sequence key="Day8Practice2Sequence"/>
    </inSequence>
    <outSequence/>
        <faultSequence/>
    </resource>

     <!-- Practice 3: Dynamic region routing -->
    <resource methods="GET" uri-template="/p3/service">
        <inSequence>
            <sequence key="Day8Practice3Sequence"/>
        </inSequence>
        <faultSequence>
            <sequence key="Day8FaultSequence"/>
        </faultSequence>
    </resource>


    <!-- Practice 4: Timeout and retry - GET (safe to retry) -->
    <resource methods="GET" uri-template="/p4/delayed-data">
    <inSequence>
        <sequence key="Day8Practice4GetSequence"/>
    </inSequence>
    <faultSequence/>
</resource>
 
    <!-- Practice 4: Timeout and retry - POST (non-idempotent, no auto-retry) -->
