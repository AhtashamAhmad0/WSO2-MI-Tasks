<?xml version="1.0" encoding="UTF-8"?>
<sequence name="Day6TroubleshootConfigSequence" xmlns="http://ws.apache.org/ns/synapse">
    <log level="custom">
        <property name="STAGE" value="CONFIG_TROUBLESHOOTING_TEST_START"/>
    </log>

    <property name="testProp" value="ALPHA"/>

    <!-- CORRECTED: Added mandatory regex attribute -->
    <filter regex="^ALPHA$" source="get-property('testProp')">
        <then>
            <payloadFactory media-type="json">
                <format>
                {
                    "status": "SUCCESS",
                    "message": "Configuration error resolved successfully!",
                    "matchedValue": "$1"
                }
                </format>
                <args>
                    <arg evaluator="xml" expression="get-property('testProp')"/>
                </args>
            </payloadFactory>
            <property name="HTTP_SC" scope="axis2" value="200"/>
            <property name="messageType" scope="axis2" value="application/json"/>
            <respond/>
        </then>
        <else>
            <payloadFactory media-type="json">
                <format>{"status": "NOT_MATCHED"}</format>
            </payloadFactory>
            <property name="HTTP_SC" scope="axis2" value="400"/>
            <property name="messageType" scope="axis2" value="application/json"/>
            <respond/>
        </else>
    </filter>
</sequence>