<?xml version="1.0" encoding="UTF-8"?>
<sequence name="Day8FaultSequence" xmlns="http://ws.apache.org/ns/synapse">
    <log level="custom">
        <property name="STAGE" value="FAULT_HANDLER"/>
        <property expression="get-property('ERROR_MESSAGE')" name="ErrorMessage"/>
    </log>
    <payloadFactory media-type="json">
        <format>
        {
            "status": "ERROR",
            "code": "500",
            "message": "An internal error occurred while processing the request."
        }
        </format>
    </payloadFactory>
    <property name="HTTP_SC" scope="axis2" value="500"/>
    <property name="messageType" scope="axis2" value="application/json"/>
    <respond/>
</sequence>