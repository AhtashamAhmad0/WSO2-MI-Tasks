<?xml version="1.0" encoding="UTF-8"?>
<sequence name="Day6Practice4Sequence" xmlns="http://ws.apache.org/ns/synapse">

    <!-- Step 1: Log Entry -->
    <log level="custom">
        <property name="STAGE" value="DAY6_PRACTICE4_ENTRY"/>
        <property expression="get-property('transport', 'X-Client-ID')" name="ClientIdHeader"/>
    </log>

    <!-- Step 2: Validate Required Header -->
    <property expression="get-property('transport', 'X-Client-ID')" name="clientId" scope="default" type="STRING"/>
    
    <filter xpath="string-length(normalize-space(get-property('clientId'))) = 0">
        <then>
            <payloadFactory media-type="json">
                <format>
                {
                    "status": "ERROR",
                    "errorCode": "400001",
                    "message": "Missing required header: X-Client-ID is mandatory."
                }
                </format>
            </payloadFactory>
            <property name="HTTP_SC" scope="axis2" value="400"/>
            <property name="messageType" scope="axis2" value="application/json"/>
            <respond/>
        </then>
    </filter>

    <!-- Step 3: Extract Request Body Property -->
    <property expression="json-eval($.accountNo)" name="accountNo" scope="default" type="STRING"/>

    <filter xpath="string-length(normalize-space(get-property('accountNo'))) = 0">
        <then>
            <payloadFactory media-type="json">
                <format>
                {
                    "status": "ERROR",
                    "errorCode": "400002",
                    "message": "Missing required payload field: accountNo is mandatory."
                }
                </format>
            </payloadFactory>
            <property name="HTTP_SC" scope="axis2" value="400"/>
            <property name="messageType" scope="axis2" value="application/json"/>
            <respond/>
        </then>
    </filter>

    <!-- Step 4: Clear outbound transport properties -->
    <property name="REST_URL_POSTFIX" scope="axis2" action="remove"/>
    <property name="HTTP_METHOD" scope="axis2" value="POST"/>
    <property name="Host" scope="transport" action="remove"/>

    <!-- Step 5: Invoke Backend Endpoint -->
    <call>
        <endpoint key="Day6Practice4Endpoint"/>
    </call>

    <!-- Step 6: Process Backend Response & Return Standard Payload -->
    <payloadFactory media-type="json">
        <format>
        {
            "status": "SUCCESS",
            "migratedFrom": "EI 6.5",
            "executedOn": "MI 4.4",
            "accountNo": "$1",
            "processedBy": "$2"
        }
        </format>
        <args>
            <arg evaluator="xml" expression="get-property('accountNo')"/>
            <arg evaluator="xml" expression="get-property('clientId')"/>
        </args>
    </payloadFactory>

    <property name="HTTP_SC" scope="axis2" value="200"/>
    <property name="messageType" scope="axis2" value="application/json"/>
    <respond/>

</sequence>