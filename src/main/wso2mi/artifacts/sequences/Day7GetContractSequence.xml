<?xml version="1.0" encoding="UTF-8"?>
<sequence name="Day7GetContractSequence" xmlns="http://ws.apache.org/ns/synapse">
    
    <log level="custom">
        <property name="STAGE" value="GET_CONTRACT_START"/>
        <property name="URI_PARAM_CONTRACT_ID" expression="get-property('uri.var.contractId')"/>
    </log>

    <!-- Extract the path parameter -->
    <property name="contractId" expression="get-property('uri.var.contractId')" scope="default" type="STRING"/>

    <!-- Validate that contractId is provided and not empty -->
    <filter xpath="string-length(normalize-space(get-property('contractId'))) &gt; 0">
        <then>
            <!-- Return verification response payload containing the requested ID -->
            <payloadFactory media-type="json">
                <format>
                {
                    "status": "SUCCESS",
                    "code": "200-OK",
                    "message": "Contract record lookup successful for verification.",
                    "data": {
                        "contractId": "$1",
                        "userId": "$1",
                        "documentName": "ServiceAgreement.pdf",
                        "verifiedStatus": "ACTIVE"
                    }
                }
                </format>
                <args>
                    <arg evaluator="xml" expression="get-property('contractId')"/>
                </args>
            </payloadFactory>

            <property name="HTTP_SC" value="200" scope="axis2"/>
            <property name="messageType" scope="axis2" value="application/json"/>

            <log level="custom">
                <property name="STAGE" value="GET_CONTRACT_SUCCESS"/>
                <property name="VerifiedContractId" expression="get-property('contractId')"/>
            </log>

            <respond/>
        </then>
        <else>
            <log level="custom">
                <property name="STAGE" value="GET_CONTRACT_VALIDATION_FAILED"/>
                <property name="Error" value="Contract ID path parameter is missing or empty."/>
            </log>

            <payloadFactory media-type="json">
                <format>
                {
                    "status": "ERROR",
                    "code": "400-BAD_REQUEST",
                    "message": "Contract ID is required in the URL path."
                }
                </format>
            </payloadFactory>

            <property name="HTTP_SC" value="400" scope="axis2"/>
            <property name="messageType" scope="axis2" value="application/json"/>
            <respond/>
        </else>
    </filter>

</sequence>