<?xml version="1.0" encoding="UTF-8"?>
<sequence name="Day8Practice4GetSequence" onError="Day8Practice4ErrorSequence" xmlns="http://ws.apache.org/ns/synapse">

    <log level="custom">
        <property name="STAGE" value="TIMEOUT_RETRY_GET_START"/>
        <property expression="get-property('retryCount')" name="RetryCount"/>
    </log>

    <!-- Initialize retry counter only on first pass -->
    <filter xpath="string-length(normalize-space(get-property('retryCount'))) = 0">
        <then>
            <property name="retryCount" scope="default" type="STRING" value="0"/>
        </then>
    </filter>

    <property name="REST_URL_POSTFIX" scope="axis2" action="remove"/>
    <property name="HTTP_METHOD" scope="axis2" value="GET"/>
    <property name="Host" scope="transport" action="remove"/>
    <property name="Accept-Encoding" scope="transport" value="identity"/>

    <log level="custom">
        <property name="STAGE" value="CALLING_SLOW_BACKEND"/>
        <property expression="get-property('retryCount')" name="RetryCount"/>
    </log>

    <!-- This call will time out because the backend delays 5s and the endpoint
         timeout is set to 2s. A timeout fault triggers onError = Day8Practice4ErrorSequence -->
    <call>
        <endpoint key="Day8Practice4Endpoint"/>
    </call>

    <!-- Reached only if the call actually succeeded before timing out -->
    <log level="custom">
        <property name="STAGE" value="BACKEND_SUCCEEDED"/>
        <property expression="get-property('retryCount')" name="RetryCount"/>
    </log>

    <payloadFactory media-type="json">
        <format>
        { "status": "SUCCESS", "code": "200", "message": "Backend responded before timeout.", "retriesUsed": "$1" }
        </format>
        <args><arg evaluator="xml" expression="get-property('retryCount')"/></args>
    </payloadFactory>
    <property name="HTTP_SC" scope="axis2" value="200"/>
    <property name="messageType" scope="axis2" value="application/json"/>
    <respond/>

</sequence>