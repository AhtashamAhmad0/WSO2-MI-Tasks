<?xml version="1.0" encoding="UTF-8"?>
<sequence name="Day10Practice4Sequence" xmlns="http://ws.apache.org/ns/synapse">
    <!-- 0. Centralized Inbound Correlation & Common Logging -->
    <sequence key="CustomerCommonLogging"/>
    
    <!-- 1. Extract Path ID and Payload Update Fields -->
    <property expression="get-property('uri.var.id')" name="customerId" scope="default" type="STRING"/>
    <property expression="json-eval($.name)" name="custName" scope="default" type="STRING"/>
    <property expression="json-eval($.email)" name="custEmail" scope="default" type="STRING"/>
    <property expression="json-eval($.status)" name="custStatus" scope="default" type="STRING"/>

    <log level="custom">
        <property expression="get-property('correlationId')" name="CORRELATION_ID"/>
        <property expression="get-property('customerId')" name="TARGET_CUSTOMER_ID"/>
        <property value="Starting PUT Customer Update Flow" name="STEP"/>
    </log>

    <!-- 2. Validate Path ID Format (Must be Numeric) -->
    <filter regex="^[0-9]+$" source="get-property('customerId')">
        <then>
            <!-- 3. Check Whether Customer Exists in DB -->
            <dblookup>
                <connection>
                    <pool>
                        <dsName>jdbc/CustomerMySQLDS</dsName>
                    </pool>
                </connection>
                <statement>
                    <sql><![CDATA[SELECT customer_id, full_name FROM customers WHERE customer_id = ?]]></sql>
                    <parameter expression="get-property('customerId')" type="INTEGER"/>
                    <result name="existingId" column="customer_id"/>
                    <result name="existingName" column="full_name"/>
                </statement>
            </dblookup>

            <filter xpath="string-length(normalize-space(get-property('existingId'))) > 0">
                <then>
                    <!-- 4. Perform Safe Update Using COALESCE to preserve unmodified fields -->
                    <dbreport>
                        <connection>
                            <pool>
                                <dsName>jdbc/CustomerMySQLDS</dsName>
                            </pool>
                        </connection>
                        <statement>
                            <sql><![CDATA[UPDATE customers SET full_name = COALESCE(NULLIF(?, ''), full_name), email = COALESCE(NULLIF(?, ''), email), account_status = COALESCE(NULLIF(?, ''), account_status) WHERE customer_id = ?]]></sql>
                            <parameter expression="get-property('custName')" type="VARCHAR"/>
                            <parameter expression="get-property('custEmail')" type="VARCHAR"/>
                            <parameter expression="get-property('custStatus')" type="VARCHAR"/>
                            <parameter expression="get-property('customerId')" type="INTEGER"/>
                        </statement>
                    </dbreport>

                    <log level="custom">
                        <property expression="get-property('correlationId')" name="CORRELATION_ID"/>
                        <property expression="get-property('customerId')" name="SUCCESS_CUSTOMER_UPDATED"/>
                    </log>

                    <!-- 5. Return Success Response with Updated Information -->
                    <payloadFactory media-type="json">
                        <format>
                        {
                            "status": "SUCCESS",
                            "code": "200",
                            "correlationId": "$1",
                            "message": "Customer ID $2 updated successfully."
                        }
                        </format>
                        <args>
                            <arg evaluator="xml" expression="get-property('correlationId')"/>
                            <arg evaluator="xml" expression="get-property('customerId')"/>
                        </args>
                    </payloadFactory>
                    <property name="HTTP_SC" scope="axis2" value="200"/>
                    <property name="messageType" scope="axis2" value="application/json"/>
                    <respond/>
                </then>
                <else>
                    <!-- 6. Customer Not Found (404) -->
                    <log level="custom">
                        <property expression="get-property('correlationId')" name="CORRELATION_ID"/>
                        <property expression="get-property('customerId')" name="WARNING_CUSTOMER_NOT_FOUND_FOR_UPDATE"/>
                    </log>
                    <payloadFactory media-type="json">
                        <format>
                        {
                            "status": "ERROR",
                            "code": "404",
                            "correlationId": "$1",
                            "message": "Cannot update. Customer ID $2 does not exist."
                        }
                        </format>
                        <args>
                            <arg evaluator="xml" expression="get-property('correlationId')"/>
                            <arg evaluator="xml" expression="get-property('customerId')"/>
                        </args>
                    </payloadFactory>
                    <property name="HTTP_SC" scope="axis2" value="404"/>
                    <property name="messageType" scope="axis2" value="application/json"/>
                    <respond/>
                </else>
            </filter>
        </then>
        <else>
            <!-- 7. Invalid ID Format (400) -->
            <log level="custom">
                <property expression="get-property('correlationId')" name="CORRELATION_ID"/>
                <property expression="get-property('customerId')" name="ERROR_INVALID_ID_FORMAT"/>
            </log>
            <payloadFactory media-type="json">
                <format>
                {
                    "status": "ERROR",
                    "code": "400",
                    "correlationId": "$1",
                    "message": "Invalid Customer ID format. ID must be a numeric integer."
                }
                </format>
                <args>
                    <arg evaluator="xml" expression="get-property('correlationId')"/>
                </args>
            </payloadFactory>
            <property name="HTTP_SC" scope="axis2" value="400"/>
            <property name="messageType" scope="axis2" value="application/json"/>
            <respond/>
        </else>
    </filter>
</sequence>